{
  "info": {
    "name": "RentSpace API - Sprint 2",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Run in order on a development database. Set base_url, admin_username, admin_password in the environment. Creates test accounts/listing/history and leaves them for inspection. Concurrency tests are in npm run test:api."
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:3000"
    }
  ],
  "item": [
    {
      "name": "01 Health / initialize unique run",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/health",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "health"
          ]
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set('run_id', Date.now().toString() + Math.floor(Math.random()*10000));",
              "pm.collectionVariables.set('test_password', 'Rs-test-' + pm.variables.replaceIn('{{$guid}}'));",
              "const start = new Date(Math.ceil(Date.now()/60000)*60000 + 48*3600000);",
              "pm.collectionVariables.set('start_time', start.toISOString());",
              "pm.collectionVariables.set('end_time', new Date(start.getTime()+2*3600000).toISOString());"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Register owner",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/auth/register",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "auth",
            "register"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"owner_{{run_id}}\",\n  \"email\": \"owner_{{run_id}}@example.com\",\n  \"password\": \"{{test_password}}\",\n  \"full_name\": \"owner\",\n  \"role\": \"owner\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set('owner_id',pm.response.json().data.user_id);",
              "pm.test(\"No password hash\",()=>pm.expect(pm.response.json().data).not.to.have.property(\"password_hash\"));"
            ]
          }
        }
      ]
    },
